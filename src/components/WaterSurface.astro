<div class="water">
	<canvas class="water-surface" aria-hidden="true"></canvas>
</div>

<script>
	const canvas = document.querySelector('canvas.water-surface');
	const wide = window.matchMedia('(min-width: 960px)');
	if (canvas instanceof HTMLCanvasElement && wide.matches) startWater(canvas);
	else wide.addEventListener('change', () => {
		if (wide.matches && canvas instanceof HTMLCanvasElement && !canvas.dataset.water) {
			canvas.dataset.water = 'on';
			startWater(canvas);
		}
	});

	function startWater(canvas) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const gl = canvas.getContext('webgl2', {
			alpha: false,
			antialias: false,
			powerPreference: 'low-power',
		});
		if (!gl || reduce) return;

		const vs = `#version 300 es
			in vec2 a;
			out vec2 vUv;
			void main() {
				vUv = vec2(a.x * 0.5 + 0.5, 0.5 - a.y * 0.5);
				gl_Position = vec4(a, 0.0, 1.0);
			}`;
		const fs = `#version 300 es
			precision highp float;
			uniform sampler2D uHeight;
			uniform vec2 uTexel;
			uniform float uTime;
			in vec2 vUv;
			out vec4 o;
			void main() {
				vec2 off = uTexel * 5.0;
				float h = texture(uHeight, vUv).r - 0.502;
				float hx = texture(uHeight, vUv + vec2(off.x, 0.0)).r - 0.502;
				float hy = texture(uHeight, vUv + vec2(0.0, off.y)).r - 0.502;
				float slope = length(vec2(h - hx, hy - h));
				float wake = smoothstep(0.012, 0.05, slope);
				float crest = pow(max(sin(vUv.x * 1.7 + vUv.y * 0.65 + uTime * 0.07), 0.0), 8.0);
				float crest2 = pow(max(sin(vUv.x * -0.85 + vUv.y * 1.35 - uTime * 0.045), 0.0), 10.0);
				float fade = smoothstep(0.0, 0.28, vUv.x)
					* smoothstep(0.0, 0.18, vUv.y) * smoothstep(1.0, 0.82, vUv.y);
				vec3 deep = vec3(0.043, 0.047, 0.047);
				vec3 silver = vec3(0.62, 0.66, 0.68);
				o = vec4(deep + silver * fade * (crest * 0.16 + crest2 * 0.09 + wake * 0.1), 1.0);
			}`;

		function compile(type, source) {
			const shader = gl.createShader(type);
			gl.shaderSource(shader, source);
			gl.compileShader(shader);
			return shader;
		}
		const program = gl.createProgram();
		gl.attachShader(program, compile(gl.VERTEX_SHADER, vs));
		gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fs));
		gl.bindAttribLocation(program, 0, 'a');
		gl.linkProgram(program);
		gl.useProgram(program);

		const buffer = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		gl.enableVertexAttribArray(0);
		gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

		const cols = 160;
		const rows = 100;
		let curr = new Float32Array(cols * rows);
		let prev = new Float32Array(cols * rows);
		let next = new Float32Array(cols * rows);
		const bytes = new Uint8Array(cols * rows);

		const texture = gl.createTexture();
		gl.bindTexture(gl.TEXTURE_2D, texture);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
		gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
		gl.texImage2D(gl.TEXTURE_2D, 0, gl.R8, cols, rows, 0, gl.RED, gl.UNSIGNED_BYTE, null);
		gl.uniform1i(gl.getUniformLocation(program, 'uHeight'), 0);
		const texel = gl.getUniformLocation(program, 'uTexel');
		const timeLoc = gl.getUniformLocation(program, 'uTime');
		gl.uniform2f(texel, 1 / cols, 1 / rows);

		function drop(u, v, mag) {
			const x = Math.round(u * (cols - 1));
			const y = Math.round(v * (rows - 1));
			const radius = 12;
			for (let dy = -radius; dy <= radius; dy++) {
				for (let dx = -radius; dx <= radius; dx++) {
					const px = x + dx;
					const py = y + dy;
					if (px <= 0 || py <= 0 || px >= cols - 1 || py >= rows - 1) continue;
					const dist = Math.hypot(dx, dy);
					if (dist > radius) continue;
					curr[py * cols + px] += mag * (1 - dist / radius);
				}
			}
		}

		function step() {
			const speed = 0.05;
			const damp = 0.99;
			for (let y = 1; y < rows - 1; y++) {
				const row = y * cols;
				for (let x = 1; x < cols - 1; x++) {
					const i = row + x;
					const lap = curr[i - 1] + curr[i + 1] + curr[i - cols] + curr[i + cols] - 4 * curr[i];
					let value = 2 * curr[i] - prev[i] + speed * lap;
					value *= damp;
					if (value > 2) value = 2;
					else if (value < -2) value = -2;
					next[i] = value;
				}
			}
			const swap = prev;
			prev = curr;
			curr = next;
			next = swap;
		}

		function upload() {
			for (let y = 1; y < rows - 1; y++) {
				const row = y * cols;
				for (let x = 1; x < cols - 1; x++) {
					const i = row + x;
					const value = (curr[i] * 2 + curr[i - 1] + curr[i + 1] + curr[i - cols] + curr[i + cols]) / 6;
					const sample = 128 + value * 40;
					bytes[i] = sample < 0 ? 0 : sample > 255 ? 255 : sample;
				}
			}
			gl.bindTexture(gl.TEXTURE_2D, texture);
			gl.texSubImage2D(gl.TEXTURE_2D, 0, 0, 0, cols, rows, gl.RED, gl.UNSIGNED_BYTE, bytes);
		}

		function resize() {
			const rect = canvas.getBoundingClientRect();
			const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
			const width = Math.max(1, Math.round(rect.width * ratio));
			const height = Math.max(1, Math.round(rect.height * ratio));
			if (canvas.width !== width || canvas.height !== height) {
				canvas.width = width;
				canvas.height = height;
				gl.viewport(0, 0, width, height);
			}
		}

		let last = null;
		function place(event, mag) {
			const rect = canvas.getBoundingClientRect();
			if (rect.width === 0 || rect.height === 0) return;
			const u = (event.clientX - rect.left) / rect.width;
			const v = (event.clientY - rect.top) / rect.height;
			if (u < 0 || v < 0 || u > 1 || v > 1) return;
			drop(u, v, mag);
		}
		canvas.addEventListener('pointerdown', (event) => {
			place(event, 0.55);
			last = [event.clientX, event.clientY];
		});
		canvas.addEventListener('pointermove', (event) => {
			if (!last) {
				last = [event.clientX, event.clientY];
				return;
			}
			const speed = Math.hypot(event.clientX - last[0], event.clientY - last[1]);
			last = [event.clientX, event.clientY];
			if (speed < 3) return;
			place(event, Math.min(0.7, speed * 0.02));
		});
		canvas.addEventListener('pointerleave', () => {
			last = null;
		});

		const started = performance.now();
		function draw(now) {
			requestAnimationFrame(draw);
			if (document.hidden) return;
			resize();
			step();
			upload();
			gl.uniform1f(timeLoc, (now - started) / 1000);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
		}
		requestAnimationFrame(draw);
	}
</script>
