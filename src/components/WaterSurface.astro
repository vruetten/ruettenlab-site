<div class="water">
	<canvas class="water-surface" aria-hidden="true"></canvas>
</div>

<script>
	const canvas = document.querySelector('canvas.water-surface');
	const wide = window.matchMedia('(min-width: 960px)');
	if (canvas instanceof HTMLCanvasElement && wide.matches) startWater(canvas);
	else wide.addEventListener('change', () => {
		if (wide.matches && canvas instanceof HTMLCanvasElement && !canvas.dataset.water) {
			canvas.dataset.water = 'on';
			startWater(canvas);
		}
	});

	function startWater(canvas) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const gl = canvas.getContext('webgl2', {
			alpha: false,
			antialias: false,
			powerPreference: 'low-power',
		});
		// The height field lives in half-float textures, so the surface stays continuous:
		// an 8-bit field quantises the slope into steps that render as hard bands.
		if (!gl || reduce || !gl.getExtension('EXT_color_buffer_float')) return;

		// The simulated sheet is wider than the visible panel by this fraction on every
		// side, so rings run out of view and die in the border instead of reflecting.
		const pad = 0.5;
		const span = 1 + 2 * pad;
		const windowOffset = pad / span;
		const windowScale = 1 / span;

		const vs = `#version 300 es
			in vec2 a;
			out vec2 vUv;
			void main() {
				vUv = a * 0.5 + 0.5;
				gl_Position = vec4(a, 0.0, 1.0);
			}`;

		// One wave-equation step. r holds the height, g the height one step earlier.
		const simFs = `#version 300 es
			precision highp float;
			uniform sampler2D uField;
			uniform vec2 uTexel;
			uniform vec4 uDrop;
			in vec2 vUv;
			out vec4 o;
			void main() {
				vec2 c = texture(uField, vUv).rg;
				float l = texture(uField, vUv - vec2(uTexel.x, 0.0)).r;
				float r = texture(uField, vUv + vec2(uTexel.x, 0.0)).r;
				float d = texture(uField, vUv - vec2(0.0, uTexel.y)).r;
				float u = texture(uField, vUv + vec2(0.0, uTexel.y)).r;
				float lap = l + r + d + u - 4.0 * c.r;
				// The outer fifth of the sheet, all of it out of view, soaks up the waves.
				vec2 edge = min(vUv, 1.0 - vUv);
				float sponge = 1.0 - 0.05 * (1.0 - smoothstep(0.0, 0.2, min(edge.x, edge.y)));
				float h = (2.0 * c.r - c.g + 0.24 * lap) * 0.995 * sponge;
				// A little viscosity rounds the crests off, so rings fade to a soft swell.
				h = mix(h, (l + r + d + u) * 0.25, 0.012);
				if (uDrop.w > 0.0) {
					float dist = length((vUv - uDrop.xy) / uTexel) / uDrop.z;
					h += uDrop.w * (0.5 + 0.5 * cos(3.14159 * min(dist, 1.0)));
				}
				o = vec4(h, c.r, 0.0, 1.0);
			}`;

		// Shade the surface from its normal, so tone varies continuously with slope.
		const drawFs = `#version 300 es
			precision highp float;
			uniform sampler2D uField;
			uniform vec2 uTexel;
			uniform vec2 uWindow;
			uniform float uTime;
			uniform float uAspect;
			in vec2 vUv;
			out vec4 o;
			void main() {
				// The panel shows the middle of the sheet.
				vec2 uv = uWindow.x + vUv * uWindow.y;
				float l = texture(uField, uv - vec2(uTexel.x, 0.0)).r;
				float r = texture(uField, uv + vec2(uTexel.x, 0.0)).r;
				float d = texture(uField, uv - vec2(0.0, uTexel.y)).r;
				float u = texture(uField, uv + vec2(0.0, uTexel.y)).r;
				vec2 grad = vec2(r - l, u - d) * 3.5;

				vec2 p = vec2(vUv.x * uAspect, vUv.y);
				float t = uTime;
				// A slow swell under the ripples, as five travelling waves whose
				// directions and speeds share no ratio, so they do not tile into a lattice.
				vec2 k1 = vec2(19.0, 8.0);
				vec2 k2 = vec2(-10.0, 17.0);
				vec2 k3 = vec2(26.0, -15.0);
				vec2 k4 = vec2(7.0, -23.0);
				vec2 k5 = vec2(-31.0, -6.0);
				grad += k1 * 0.0060 * cos(dot(k1, p) + t * 0.42);
				grad += k2 * 0.0050 * cos(dot(k2, p) - t * 0.31);
				grad += k3 * 0.0026 * cos(dot(k3, p) + t * 0.57);
				grad += k4 * 0.0030 * cos(dot(k4, p) - t * 0.23);
				grad += k5 * 0.0018 * cos(dot(k5, p) + t * 0.36);

				// A fine, faster ripple on top. Its peaks become the sparkle.
				vec2 f1 = vec2(83.0, 47.0);
				vec2 f2 = vec2(-51.0, 97.0);
				vec2 f3 = vec2(120.0, -33.0);
				vec2 f4 = vec2(-97.0, -71.0);
				float fine = sin(dot(f1, p) + t * 2.1) + sin(dot(f2, p) - t * 1.7)
					+ sin(dot(f3, p) + t * 2.9) + sin(dot(f4, p) - t * 2.3);

				vec3 view = vec3(0.0, 0.0, 1.0);
				vec3 light = normalize(vec3(-0.35, 0.55, 0.75));
				vec3 half1 = normalize(light + view);

				vec3 n = normalize(vec3(-grad, 1.0));
				float spec = pow(max(dot(n, half1), 0.0), 24.0);
				vec3 refl = reflect(-view, n);
				// Zero on a flat surface, so still water stays as dark as the page.
				float sky = max(smoothstep(-0.35, 0.45, refl.y * 0.7 - refl.x * 0.3) - 0.4375, 0.0);
				float rim = pow(1.0 - max(dot(n, view), 0.0), 2.0);

				// Sparkle: points at the peaks of the fine ripple, only on the lit flanks
				// of the swell.
				float spark = pow(max(fine * 0.25, 0.0), 8.0) * smoothstep(0.0, 0.12, sky + spec * 0.5);

				// The surface reflects a sky that is blue on one side and amber on the
				// other, split across the light direction, so the two flanks of a ring take
				// opposite tints and the split drifts slowly.
				vec3 cool = vec3(0.45, 0.66, 0.92);
				vec3 warm = vec3(0.96, 0.62, 0.30);
				float side = refl.x * 0.84 + refl.y * 0.54 + 0.15 * sin(t * 0.15);
				vec3 tint = mix(cool, warm, smoothstep(-0.2, 0.2, side));
				vec3 silver = vec3(0.64, 0.67, 0.69);
				vec3 glint = mix(silver, tint, 0.7);

				// The panel melts into the page on every side, widest on the text side.
				float fade = smoothstep(0.0, 0.38, vUv.x) * smoothstep(1.0, 0.72, vUv.x)
					* smoothstep(0.0, 0.3, vUv.y) * smoothstep(1.0, 0.7, vUv.y);
				vec3 deep = vec3(0.043, 0.047, 0.047);
				vec3 light1 = glint * (spec * 0.34 + sky * 0.14 + rim * 0.18)
					+ mix(silver, warm, 0.35) * spark * 0.45;
				o = vec4(deep + light1 * fade, 1.0);
			}`;

		function compile(type, source) {
			const shader = gl.createShader(type);
			gl.shaderSource(shader, source);
			gl.compileShader(shader);
			if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
				throw new Error(gl.getShaderInfoLog(shader) || 'shader');
			}
			return shader;
		}
		function program(fragment) {
			const p = gl.createProgram();
			gl.attachShader(p, compile(gl.VERTEX_SHADER, vs));
			gl.attachShader(p, compile(gl.FRAGMENT_SHADER, fragment));
			gl.bindAttribLocation(p, 0, 'a');
			gl.linkProgram(p);
			return p;
		}
		let sim;
		let draw;
		try {
			sim = program(simFs);
			draw = program(drawFs);
		} catch (error) {
			console.error('water shader', error);
			return;
		}
		const simLoc = {
			field: gl.getUniformLocation(sim, 'uField'),
			texel: gl.getUniformLocation(sim, 'uTexel'),
			drop: gl.getUniformLocation(sim, 'uDrop'),
		};
		const drawLoc = {
			field: gl.getUniformLocation(draw, 'uField'),
			texel: gl.getUniformLocation(draw, 'uTexel'),
			window: gl.getUniformLocation(draw, 'uWindow'),
			time: gl.getUniformLocation(draw, 'uTime'),
			aspect: gl.getUniformLocation(draw, 'uAspect'),
		};

		const buffer = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		gl.enableVertexAttribArray(0);
		gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

		// Two half-float fields, swapped every step.
		let cols = 0;
		let rows = 0;
		const fields = [];
		function makeField() {
			const texture = gl.createTexture();
			gl.bindTexture(gl.TEXTURE_2D, texture);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
			gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA16F, cols, rows, 0, gl.RGBA, gl.HALF_FLOAT, null);
			const framebuffer = gl.createFramebuffer();
			gl.bindFramebuffer(gl.FRAMEBUFFER, framebuffer);
			gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, texture, 0);
			gl.clearColor(0, 0, 0, 1);
			gl.clear(gl.COLOR_BUFFER_BIT);
			return { texture, framebuffer };
		}
		function resize() {
			const rect = canvas.getBoundingClientRect();
			const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
			const width = Math.max(1, Math.round(rect.width * ratio));
			const height = Math.max(1, Math.round(rect.height * ratio));
			if (canvas.width !== width || canvas.height !== height) {
				canvas.width = width;
				canvas.height = height;
			}
			const nextCols = Math.max(2, Math.round(rect.width * span * 0.6));
			const nextRows = Math.max(2, Math.round(rect.height * span * 0.6));
			if (nextCols !== cols || nextRows !== rows) {
				cols = nextCols;
				rows = nextRows;
				for (const field of fields.splice(0)) {
					gl.deleteTexture(field.texture);
					gl.deleteFramebuffer(field.framebuffer);
				}
				fields.push(makeField(), makeField());
			}
		}

		// Drops queue up and enter the field one per simulation step. Positions are in
		// panel coordinates and map into the middle of the sheet.
		const drops = [];
		function drop(u, v, radius, mag) {
			drops.push([windowOffset + u * windowScale, windowOffset + v * windowScale, radius, mag]);
		}
		function place(event, mag, radius) {
			const rect = canvas.getBoundingClientRect();
			if (rect.width === 0 || rect.height === 0) return;
			const u = (event.clientX - rect.left) / rect.width;
			const v = 1 - (event.clientY - rect.top) / rect.height;
			if (u < 0 || v < 0 || u > 1 || v > 1) return;
			drop(u, v, radius, mag);
		}
		let last = null;
		canvas.addEventListener('pointerdown', (event) => {
			place(event, 0.4, 12);
			last = [event.clientX, event.clientY];
		});
		canvas.addEventListener('pointermove', (event) => {
			if (!last) {
				last = [event.clientX, event.clientY];
				return;
			}
			const moved = Math.hypot(event.clientX - last[0], event.clientY - last[1]);
			if (moved < 14) return;
			last = [event.clientX, event.clientY];
			place(event, Math.min(0.12, moved * 0.005), 10);
		});
		canvas.addEventListener('pointerleave', () => {
			last = null;
		});

		// A random drop every few seconds keeps rings crossing the surface when nobody is
		// pointing at the water. Some land just outside the panel, so rings also arrive
		// from beyond its edges.
		let nextRain = 800;
		function rain(elapsed) {
			if (elapsed < nextRain) return;
			nextRain = elapsed + 2200 + Math.random() * 2600;
			drop(-0.2 + Math.random() * 1.4, -0.2 + Math.random() * 1.4, 12, 0.15 + Math.random() * 0.15);
		}

		function step() {
			const [from, to] = fields;
			gl.useProgram(sim);
			gl.bindFramebuffer(gl.FRAMEBUFFER, to.framebuffer);
			gl.viewport(0, 0, cols, rows);
			gl.activeTexture(gl.TEXTURE0);
			gl.bindTexture(gl.TEXTURE_2D, from.texture);
			gl.uniform1i(simLoc.field, 0);
			gl.uniform2f(simLoc.texel, 1 / cols, 1 / rows);
			const next = drops.shift();
			if (next) gl.uniform4f(simLoc.drop, next[0], next[1], next[2], next[3]);
			else gl.uniform4f(simLoc.drop, 0, 0, 1, 0);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
			fields.reverse();
		}

		// The wave advances 120 steps a second whatever the display's refresh rate.
		const stepMs = 1000 / 120;
		const started = performance.now();
		let stepped = 0;
		function frame(now) {
			requestAnimationFrame(frame);
			if (document.hidden) return;
			resize();
			const elapsed = now - started;
			rain(elapsed);
			const due = Math.min(4, Math.floor(elapsed / stepMs) - stepped);
			for (let i = 0; i < due; i++) step();
			stepped = Math.floor(elapsed / stepMs);
			gl.useProgram(draw);
			gl.bindFramebuffer(gl.FRAMEBUFFER, null);
			gl.viewport(0, 0, canvas.width, canvas.height);
			gl.activeTexture(gl.TEXTURE0);
			gl.bindTexture(gl.TEXTURE_2D, fields[0].texture);
			gl.uniform1i(drawLoc.field, 0);
			gl.uniform2f(drawLoc.texel, 1 / cols, 1 / rows);
			gl.uniform2f(drawLoc.window, windowOffset, windowScale);
			gl.uniform1f(drawLoc.time, elapsed / 1000);
			gl.uniform1f(drawLoc.aspect, canvas.width / canvas.height);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
		}
		requestAnimationFrame(frame);
	}
</script>
