---
import { siteHref } from '../site';

const movie = siteHref('research/wholistic-imaging.mp4');
const still = siteHref('research/wholistic-imaging.jpg');
---

<figure class="film">
	<video autoplay muted loop playsinline poster={still} aria-label="Sagittal view of a larval zebrafish with major organs indicated.">
		<source src={movie} type="video/mp4" />
	</video>
	<img class="still" src={still} alt="Sagittal view of a larval zebrafish with major organs indicated." />
</figure>
