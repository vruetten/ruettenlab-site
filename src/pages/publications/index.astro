---
import { getCollection } from 'astro:content';
import Authors from '../../components/Authors.astro';
import PaperFiles from '../../components/PaperFiles.astro';
import Base from '../../layouts/Base.astro';
import { hasBody } from '../../papers';
import { profiles, siteHref } from '../../site';

const papers = (await getCollection('publications')).sort((a, b) => {
	const byYear = b.data.year - a.data.year;
	if (byYear !== 0) return byYear;
	return a.data.title.localeCompare(b.data.title);
});

type Paper = (typeof papers)[number];
type Kind = 'paper' | 'preprint' | 'protocol';

function kindOf(venue: string): Kind {
	if (/protocols\.io/i.test(venue)) return 'protocol';
	if (/biorxiv/i.test(venue)) return 'preprint';
	return 'paper';
}

const kindOrder: Kind[] = ['paper', 'preprint', 'protocol'];
const kindLabel: Record<Exclude<Kind, 'paper'>, string> = {
	preprint: 'Preprints',
	protocol: 'Protocols',
};

const years: { year: number; groups: { kind: Kind; papers: Paper[] }[] }[] = [];
for (const paper of papers) {
	const last = years[years.length - 1];
	if (!last || last.year !== paper.data.year) years.push({ year: paper.data.year, groups: [] });
	const year = years[years.length - 1];
	const kind = kindOf(paper.data.venue);
	const group = year.groups.find((item) => item.kind === kind);
	if (group) group.papers.push(paper);
	else year.groups.push({ kind, papers: [paper] });
}
for (const year of years) {
	year.groups.sort((a, b) => kindOrder.indexOf(a.kind) - kindOrder.indexOf(b.kind));
}
---

<Base>
	<ul class="profiles">
		{
			profiles.map((profile) => (
				<li>
					<a class="soft" href={profile.url}>{profile.label}</a>
				</li>
			))
		}
	</ul>
	<div class="years">
		{
			years.map((group) => (
				<section>
					<h2>{group.year}</h2>
					<div>
						{group.groups.map((kindGroup) => (
							<div class="kind">
								{kindGroup.kind !== 'paper' && <h3>{kindLabel[kindGroup.kind]}</h3>}
								<ol>
									{kindGroup.papers.map((paper) => {
										const page = hasBody(paper.body)
											? siteHref(`publications/${paper.id}/`)
											: paper.data.url;
										return (
											<li class="paper">
												<div>
													<div class="paper-head">
														<a class="paper-title" href={page}>{paper.data.title}</a>
														<span class="paper-venue">{paper.data.venue}</span>
														<PaperFiles pdf={paper.data.pdf} />
													</div>
													<div class="paper-authors">
														<Authors authors={paper.data.authors} />
													</div>
													{paper.data.featured && paper.data.featured.length > 0 && (
														<div class="featured">
															Featured by{' '}
															{paper.data.featured.map((item, index) => (
																<>
																	{index > 0 ? ', ' : null}
																	<a href={item.url} target="_blank" rel="noopener noreferrer">
																		{item.label}
																	</a>
																</>
															))}
														</div>
													)}
												</div>
											</li>
										);
									})}
								</ol>
							</div>
						))}
					</div>
				</section>
			))
		}
	</div>
</Base>
