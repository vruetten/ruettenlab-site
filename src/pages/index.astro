---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, labName, siteHref } from '../site';

const news = (await getCollection('news'))
	.sort((a, b) => {
		const byLead = Number(b.data.lead) - Number(a.data.lead);
		if (byLead !== 0) return byLead;
		const byPin = Number(b.data.pin) - Number(a.data.pin);
		if (byPin !== 0) return byPin;
		const rankA = a.data.rank ?? Number.POSITIVE_INFINITY;
		const rankB = b.data.rank ?? Number.POSITIVE_INFINITY;
		if (rankA !== rankB) return rankA - rankB;
		const byDate = b.data.date.valueOf() - a.data.date.valueOf();
		if (byDate !== 0) return byDate;
		const label = (item: (typeof news)[number]) =>
			item.data.kind === 'press' ? item.data.title : item.data.text;
		return label(a).localeCompare(label(b));
	})
	.filter((item) => item.data.size !== 'small')
	.slice(0, 5);
const threads = await getCollection('research');
---

<Base>
	<p class="volume">No volume yet</p>
	<div class="stage">
		<div>
			<h1>{labName}</h1>
			<p class="sentence">{threads[0]?.data.summary}</p>
			<p><a href={siteHref('join/')}>Join</a></p>
		</div>
		<div>
			<ul class="news-list">
				{
					news.map((item) => (
						<li>
							<time datetime={item.data.date.toISOString().slice(0, 10)}>
								{formatDate(item.data.date, item.data.datePrecision)}
							</time>
							{
								item.data.kind === 'press' ? (
									<a href={item.data.url} target="_blank" rel="noopener noreferrer">
										{item.data.outlet}
									</a>
								) : (
									<span>{item.data.text}</span>
								)
							}
						</li>
					))
				}
			</ul>
			<p>
				<a href={siteHref('news/')}>News</a>
			</p>
		</div>
	</div>
</Base>
