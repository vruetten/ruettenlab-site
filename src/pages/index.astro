---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, isUpcoming, labName, siteHref } from '../site';

const news = (await getCollection('news'))
	.sort((a, b) => {
		const byDate = b.data.date.valueOf() - a.data.date.valueOf();
		if (byDate !== 0) return byDate;
		const label = (item: (typeof news)[number]) =>
			item.data.kind === 'press' ? item.data.title : item.data.text;
		return label(a).localeCompare(label(b));
	})
	.filter((item) => item.data.size !== 'small')
	.slice(0, 5);
const threads = await getCollection('research');
---

<Base>
	<p class="volume">No volume yet</p>
	<div class="stage">
		<div>
			<h1>{labName}</h1>
			{threads[0]?.data.summary && <p class="sentence">{threads[0].data.summary}</p>}
		</div>
		<div>
			<p>
				<a class="news-label" href={siteHref('news/')}>News</a>
			</p>
			<ul class="news-list">
				{
					news.map((item) => (
						<li class:list={[{ upcoming: isUpcoming(item.data.date, item.data.datePrecision) }]}>
							<time datetime={item.data.date.toISOString().slice(0, 10)}>
								{formatDate(item.data.date, item.data.datePrecision)}
							</time>
							{
								item.data.kind === 'press' ? (
									<a href={item.data.url} target="_blank" rel="noopener noreferrer">
										<span>{item.data.line ?? `WHOLISTIC featured in ${item.data.outlet}`}</span>
									</a>
								) : item.id === 'princeton-2027-09' ? (
									<a class="join" href={siteHref('join/')}>
										<span>
											{item.data.text} <span class="join-word">Join!</span>
										</span>
									</a>
								) : (
									<span>{item.data.text}</span>
								)
							}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</Base>
