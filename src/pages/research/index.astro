---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const threads = await getCollection('research');
const thread = threads[0];
---

<Base>
	{
		thread && (
			<>
				<h1 class="lead">{thread.data.title}</h1>
				<p>{thread.data.summary}</p>
			</>
		)
	}
</Base>
