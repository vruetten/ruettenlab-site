---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, isUpcoming } from '../../site';

const images = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/news/*.{jpg,jpeg,png,webp}',
	{ eager: true },
);

function imageFor(name: string) {
	const entry = Object.entries(images).find(([key]) => key.endsWith(`/${name}`));
	if (!entry) throw new Error(`Missing news image ${name}`);
	return entry[1].default;
}

const logos = import.meta.glob<{ default: ImageMetadata }>('../../assets/news/logos/*.png', {
	eager: true,
});

function logoFor(name: string) {
	const entry = Object.entries(logos).find(([key]) => key.endsWith(`/${name}`));
	if (!entry) throw new Error(`Missing news logo ${name}`);
	return entry[1].default;
}

// Widths offered to the browser, capped at 1000 px: a phone at three device pixels per
// CSS pixel would otherwise pick a 1600 px file for a 390 px wide card.
function widthsFor(image: ImageMetadata) {
	const steps = [480, 800, 1000].filter((width) => width < image.width);
	if (image.width < 1000) steps.push(image.width);
	return steps;
}

// Newest first, by date alone.
const news = (await getCollection('news')).sort((a, b) => {
	const byDate = b.data.date.valueOf() - a.data.date.valueOf();
	if (byDate !== 0) return byDate;
	const label = (item: (typeof news)[number]) =>
		item.data.kind === 'press' ? item.data.title : item.data.text;
	return label(a).localeCompare(label(b));
});

// One grid in news order. An item with an image fills a cell as a card; items without
// one are briefs. A run of consecutive briefs is split into cells of two, with a run of
// odd length closing on a cell of three, so no brief sits alone in a cell unless the
// run is a single brief.
type Item = (typeof news)[number];
type Cell = { card: Item } | { briefs: Item[] };
const cells: Cell[] = [];
let run: Item[] = [];
function closeRun() {
	while (run.length > 0) {
		const take = run.length === 3 ? 3 : Math.min(2, run.length);
		cells.push({ briefs: run.splice(0, take) });
	}
}
for (const item of news) {
	if (item.data.image) {
		closeRun();
		cells.push({ card: item });
	} else run.push(item);
}
closeRun();
---

<Base>
	<ul class="press-grid">
		{
			cells.map((cell, index) => {
				if ('briefs' in cell) {
					return (
						<li class="brief-stack">
							{cell.briefs.map((item) => {
								const label = item.data.kind === 'press' ? item.data.title : item.data.text;
								const logo = item.data.logo ? logoFor(item.data.logo) : null;
								const body = (
									<>
										{logo && (
											<span
												class="brief-logo"
												aria-hidden="true"
												style={`--logo: url('${logo.src}')`}
											/>
										)}
										<span class="brief-text">
											<time class="brief-date" datetime={item.data.date.toISOString().slice(0, 10)}>
												{formatDate(item.data.date, item.data.datePrecision)}
											</time>
											<span class="brief-title">{label}</span>
										</span>
									</>
								);
								const upcoming = isUpcoming(item.data.date, item.data.datePrecision);
								return item.data.url ? (
									<a class:list={['brief', { upcoming }]} href={item.data.url} target="_blank" rel="noopener noreferrer">
										{body}
									</a>
								) : (
									<div class:list={['brief', { upcoming }]}>{body}</div>
								);
							})}
						</li>
					);
				}
				const item = cell.card;
				const name = item.data.image;
				if (!name) return null;
				const photo = imageFor(name);
				const title = item.data.kind === 'press' ? item.data.title : item.data.text;
				const credit =
					item.data.kind === 'press' && item.data.outlet
						? `Featured by ${item.data.outlet}`
						: '';
				const alt = item.data.kind === 'lab' ? 'A red sandstone hall at Princeton University, seen through trees' : '';
				return (
				<li class:list={[{ small: item.data.size === 'small', upcoming: isUpcoming(item.data.date, item.data.datePrecision) }]}>
					{item.data.url ? (
						<a class="press-card" href={item.data.url} target="_blank" rel="noopener noreferrer">
							<span class="press-figure">
								<Image
									src={photo}
									alt={alt}
									widths={widthsFor(photo)}
									sizes="(max-width: 800px) 100vw, 33vw"
									quality={72}
									loading={index < 3 ? 'eager' : 'lazy'}
									decoding="async"
								/>
							</span>
							<p class="press-meta">
								<time datetime={item.data.date.toISOString().slice(0, 10)}>
									{formatDate(item.data.date, item.data.datePrecision)}
								</time>
								{credit && <span>{credit}</span>}
							</p>
							<span class="press-title">{title}</span>
						</a>
					) : (
						<div class="press-card">
							<span class="press-figure">
								<Image
									src={photo}
									alt={alt}
									widths={widthsFor(photo)}
									sizes="(max-width: 800px) 100vw, 33vw"
									quality={72}
									loading={index < 3 ? 'eager' : 'lazy'}
									decoding="async"
								/>
							</span>
							<p class="press-meta">
								<time datetime={item.data.date.toISOString().slice(0, 10)}>
									{formatDate(item.data.date, item.data.datePrecision)}
								</time>
								{credit && <span>{credit}</span>}
							</p>
							<span class="press-title">{title}</span>
						</div>
					)}
				</li>
				);
			})
		}
	</ul>
</Base>
