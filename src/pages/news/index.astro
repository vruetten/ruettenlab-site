---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, isUpcoming } from '../../site';

const images = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/news/*.{jpg,jpeg,png,webp}',
	{ eager: true },
);

function imageFor(name: string) {
	const entry = Object.entries(images).find(([key]) => key.endsWith(`/${name}`));
	if (!entry) throw new Error(`Missing news image ${name}`);
	return entry[1].default;
}

function widthsFor(image: ImageMetadata) {
	const steps = [480, 768, 1200, 1600].filter((width) => width < image.width);
	steps.push(image.width);
	return steps;
}

const news = (await getCollection('news')).sort((a, b) => {
	const byLead = Number(b.data.lead) - Number(a.data.lead);
	if (byLead !== 0) return byLead;
	const byPin = Number(b.data.pin) - Number(a.data.pin);
	if (byPin !== 0) return byPin;
	const rankA = a.data.rank ?? Number.POSITIVE_INFINITY;
	const rankB = b.data.rank ?? Number.POSITIVE_INFINITY;
	if (rankA !== rankB) return rankA - rankB;
	const byDate = b.data.date.valueOf() - a.data.date.valueOf();
	if (byDate !== 0) return byDate;
	const label = (item: (typeof news)[number]) =>
		item.data.kind === 'press' ? item.data.title : item.data.text;
	return label(a).localeCompare(label(b));
});

const cards = news.filter((item) => item.data.image);
const lab = news.filter((item) => item.data.kind === 'lab' && !item.data.image);
---

<Base>
	<style slot="head" is:inline>
		html:not([data-news='ready']) body {
			opacity: 0;
		}
	</style>
	<noscript slot="head">
		<style is:inline>
			body {
				opacity: 1 !important;
			}
		</style>
	</noscript>
	<ul class="press-grid">
		{
			cards.map((item) => {
				const name = item.data.image;
				if (!name) return null;
				const photo = imageFor(name);
				const title = item.data.kind === 'press' ? item.data.title : item.data.text;
				const credit =
					item.data.kind === 'press' && item.data.outlet
						? `Featured by ${item.data.outlet}`
						: '';
				const alt = item.data.kind === 'lab' ? 'Nassau Hall at Princeton University' : '';
				return (
				<li class:list={[{ small: item.data.size === 'small', upcoming: isUpcoming(item.data.date, item.data.datePrecision) }]}>
					{item.data.url ? (
						<a class="press-card" href={item.data.url} target="_blank" rel="noopener noreferrer">
							<span class="press-figure">
								<Image
									src={photo}
									alt={alt}
									widths={widthsFor(photo)}
									sizes="(max-width: 800px) 100vw, 33vw"
									quality={90}
									loading="eager"
									decoding="async"
								/>
							</span>
							<p class="press-meta">
								<time datetime={item.data.date.toISOString().slice(0, 10)}>
									{formatDate(item.data.date, item.data.datePrecision)}
								</time>
								{credit && <span>{credit}</span>}
							</p>
							<span class="press-title">{title}</span>
						</a>
					) : (
						<div class="press-card">
							<span class="press-figure">
								<Image
									src={photo}
									alt={alt}
									widths={widthsFor(photo)}
									sizes="(max-width: 800px) 100vw, 33vw"
									quality={90}
									loading="eager"
									decoding="async"
								/>
							</span>
							<p class="press-meta">
								<time datetime={item.data.date.toISOString().slice(0, 10)}>
									{formatDate(item.data.date, item.data.datePrecision)}
								</time>
								{credit && <span>{credit}</span>}
							</p>
							<span class="press-title">{title}</span>
						</div>
					)}
				</li>
				);
			})
		}
	</ul>
	{
		lab.length > 0 && (
			<section class="lab-news">
				<h2>Lab</h2>
				<ul class="lab-list">
					{lab.map((item) => (
						<li class:list={[{ upcoming: isUpcoming(item.data.date, item.data.datePrecision) }]}>
							<time datetime={item.data.date.toISOString().slice(0, 10)}>
								{formatDate(item.data.date, item.data.datePrecision)}
							</time>
							<span>{item.data.text}</span>
						</li>
					))}
				</ul>
			</section>
		)
	}
	<script is:inline>
		(function () {
			var root = document.documentElement;
			var images = document.querySelectorAll('.press-figure img');
			var remaining = images.length;
			function reveal() {
				root.setAttribute('data-news', 'ready');
			}
			if (!remaining) {
				reveal();
				return;
			}
			function finish() {
				remaining -= 1;
				if (remaining <= 0) reveal();
			}
			function settle(img) {
				if (img.complete && img.naturalWidth > 0) {
					finish();
					return;
				}
				if (img.complete) {
					if (typeof img.decode === 'function') img.decode().then(finish, finish);
					else finish();
					return;
				}
				img.addEventListener('load', finish, { once: true });
				img.addEventListener('error', finish, { once: true });
			}
			for (var i = 0; i < images.length; i++) settle(images[i]);
			setTimeout(reveal, 12000);
		})();
	</script>
</Base>
