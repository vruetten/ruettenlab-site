---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { email } from '../../site';

const portraits = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/people/*.{jpg,jpeg,png,webp}',
	{ eager: true },
);

function portraitFor(name: string | undefined) {
	if (!name) return undefined;
	const entry = Object.entries(portraits).find(([key]) => key.endsWith(`/${name}`));
	if (!entry) throw new Error(`Missing portrait ${name}`);
	return entry[1].default;
}

function portraitWidths(image: ImageMetadata) {
	const steps = [480, 720, 1080].filter((width) => width < image.width);
	steps.push(Math.min(image.width, 1080));
	return [...new Set(steps)];
}

const people = (await getCollection('people')).sort((a, b) => {
	const orderA = a.data.order ?? Number.POSITIVE_INFINITY;
	const orderB = b.data.order ?? Number.POSITIVE_INFINITY;
	if (orderA !== orderB) return orderA - orderB;
	const byName = a.data.name.localeCompare(b.data.name);
	if (byName !== 0) return byName;
	return a.id.localeCompare(b.id);
});
---

<Base showAddress>
	<style slot="head" is:inline>
		html:not([data-people='ready']) body {
			opacity: 0;
		}
	</style>
	<noscript slot="head">
		<style is:inline>
			body {
				opacity: 1 !important;
			}
		</style>
	</noscript>
	<ul class="people">
		{
			people.map((person) => {
				const photo = portraitFor(person.data.image);
				const links = [
					...(person.data.links ?? []),
					...(person.data.showEmail ? [{ label: email, url: `mailto:${email}` }] : []),
				];
				return (
					<li class:list={['vignette', { 'has-photo': Boolean(photo) }]}>
						{photo && (
							<span class="portrait">
								<Image
									class:list={[`crop-${person.data.crop}`]}
									src={photo}
									alt=""
									width={Math.min(photo.width, 1080)}
									height={Math.round(
										(photo.height * Math.min(photo.width, 1080)) / photo.width,
									)}
									widths={portraitWidths(photo)}
									sizes="14rem"
									quality={90}
									loading="eager"
									decoding="async"
									fetchpriority="high"
								/>
							</span>
						)}
						<div>
							<h2>{person.data.name}</h2>
							{person.data.role ? <p class="role">{person.data.role}</p> : null}
							{links.length > 0 && (
								<ul class="person-links">
									{links.map((link) => (
										<li>
											<a class="soft" href={link.url}>{link.label}</a>
										</li>
									))}
								</ul>
							)}
						</div>
					</li>
				);
			})
		}
	</ul>
	<script is:inline>
		(function () {
			var root = document.documentElement;
			var images = document.querySelectorAll('.portrait img');
			var remaining = images.length;
			function reveal() {
				root.setAttribute('data-people', 'ready');
			}
			if (!remaining) {
				reveal();
				return;
			}
			function finish() {
				remaining -= 1;
				if (remaining <= 0) reveal();
			}
			function settle(img) {
				if (img.complete && img.naturalWidth > 0) {
					finish();
					return;
				}
				if (img.complete) {
					if (typeof img.decode === 'function') img.decode().then(finish, finish);
					else finish();
					return;
				}
				img.addEventListener('load', finish, { once: true });
				img.addEventListener('error', finish, { once: true });
			}
			for (var i = 0; i < images.length; i++) settle(images[i]);
			setTimeout(reveal, 12000);
		})();
	</script>
</Base>
