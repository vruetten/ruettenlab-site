---
import '../styles/site.css';
import '../styles/direction-a.css';
import '../styles/direction-b.css';
import { email, janeliaUrl, labName, nav, odbiUrl, pniUrl, princetonUrl, siteHref } from '../site';

interface Props {
	showEmail?: boolean;
	frontmatter?: { showEmail?: boolean };
}

const { showEmail = false, frontmatter } = Astro.props;
const emailUnderBody = showEmail || frontmatter?.showEmail === true;
---

<html lang="en" data-direction="b">
	<head>
		<script is:inline>
			/* ruetten-direction */
			(function () {
				var root = document.documentElement;
				var direction = 'b';
				var theme = 'light';
				try {
					var storedDirection = localStorage.getItem('ruetten-direction');
					var storedTheme = localStorage.getItem('ruetten-theme');
					if (storedDirection === 'a' || storedDirection === 'b') direction = storedDirection;
					if (storedTheme === 'light' || storedTheme === 'dark') theme = storedTheme;
					else if (window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
				} catch (error) {
					theme = 'light';
				}
				root.setAttribute('data-direction', direction);
				root.setAttribute('data-theme', theme);
			})();
		</script>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={siteHref('favicon.svg')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<meta name="generator" content={Astro.generator} />
		<title>{labName}</title>
	</head>
	<body>
		<header class="wrap">
			<div class="mast">
				<a class="wordmark" href={siteHref()}>{labName}</a>
				<nav>
					<ul>
						{
							nav.map((item) => (
								<li>
									<a href={siteHref(item.path)}>{item.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
			</div>
			<div class="marks">
				<a href={princetonUrl}>
					<img class="princeton-logo princeton-logo-color" src={siteHref('marks/princeton-wordmark.svg')} alt="Princeton University" width="263" height="72" />
					<img class="princeton-logo princeton-logo-white" src={siteHref('marks/princeton-wordmark-white.svg')} alt="Princeton University" width="1852" height="500" />
				</a>
				<a href={pniUrl}>
					<img class="pni pni-color" src={siteHref('marks/pni.svg')} alt="Princeton Neuroscience Institute" width="341" height="85" />
					<img class="pni pni-dark" src={siteHref('marks/pni-dark.svg')} alt="Princeton Neuroscience Institute" width="341" height="85" />
				</a>
				<a href={odbiUrl}>
					<img class="odbi odbi-color" src={siteHref('marks/odbi.png')} alt="Omenn-Darling Bioengineering Institute" width="677" height="186" />
					<img class="odbi odbi-dark" src={siteHref('marks/odbi-dark.png')} alt="Omenn-Darling Bioengineering Institute" width="677" height="186" />
				</a>
			</div>
			<div class="controls">
				<div class="switch" role="group" aria-label="Style">
					<button type="button" data-set-direction="a" aria-pressed="false">A</button>
					<button type="button" data-set-direction="b" aria-pressed="false">B</button>
				</div>
				<button type="button" class="theme" data-toggle-theme aria-label="Switch to dark">
					<svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.8 4.8l1.8 1.8M17.4 17.4l1.8 1.8M19.2 4.8l-1.8 1.8M6.6 17.4l-1.8 1.8"></path>
					</svg>
					<svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M20 14.5A8.2 8.2 0 0 1 9.5 4 6.6 6.6 0 1 0 20 14.5z"></path>
					</svg>
				</button>
			</div>
		</header>
		<main class="wrap">
			<slot />
			{
				emailUnderBody && (
					<p>
						<a href={`mailto:${email}`}>{email}</a>
					</p>
				)
			}
		</main>
		<footer class="contact-bar">
			<a href={`mailto:${email}`}>{email}</a>
			<a href={janeliaUrl}>WHOLISTIC</a>
		</footer>
		<script is:inline>
			/* ruetten-direction */
			(function () {
				var root = document.documentElement;
				var directionKey = 'ruetten-direction';
				var themeKey = 'ruetten-theme';
				function paint() {
					var buttons = document.querySelectorAll('[data-set-direction]');
					for (var i = 0; i < buttons.length; i++) {
						var button = buttons[i];
						var pressed = button.getAttribute('data-set-direction') === root.getAttribute('data-direction');
						button.setAttribute('aria-pressed', pressed ? 'true' : 'false');
					}
					var themeButton = document.querySelector('[data-toggle-theme]');
					if (themeButton) {
						var dark = root.getAttribute('data-theme') === 'dark';
						themeButton.setAttribute('aria-pressed', dark ? 'true' : 'false');
						themeButton.setAttribute('aria-label', dark ? 'Switch to light' : 'Switch to dark');
					}
				}
				document.addEventListener('click', function (event) {
					var button = event.target.closest('[data-set-direction], [data-toggle-theme]');
					if (!button) return;
					var direction = button.getAttribute('data-set-direction');
					var theme = null;
					if (button.hasAttribute('data-toggle-theme')) {
						theme = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
					}
					try {
						if (direction) {
							root.setAttribute('data-direction', direction);
							localStorage.setItem(directionKey, direction);
						}
						if (theme) {
							root.setAttribute('data-theme', theme);
							localStorage.setItem(themeKey, theme);
						}
					} catch (error) {
						if (direction) root.setAttribute('data-direction', direction);
						if (theme) root.setAttribute('data-theme', theme);
					}
					paint();
				});
				paint();
			})();
		</script>
		<script is:inline>
			(function () {
				var origin = window.location.origin;
				var links = document.querySelectorAll('a[href]');
				for (var i = 0; i < links.length; i++) {
					var link = links[i];
					var href = link.getAttribute('href');
					if (!href || href.charAt(0) === '#') continue;
					var url;
					try {
						url = new URL(href, window.location.href);
					} catch (error) {
						continue;
					}
					var outside =
						url.origin !== origin && (url.protocol === 'http:' || url.protocol === 'https:');
					if (!outside) {
						if (link.getAttribute('target') === '_blank') link.removeAttribute('target');
						continue;
					}
					link.setAttribute('target', '_blank');
					var rel = link.getAttribute('rel') || '';
					if (rel.indexOf('noopener') === -1) rel = (rel + ' noopener').trim();
					if (rel.indexOf('noreferrer') === -1) rel = (rel + ' noreferrer').trim();
					link.setAttribute('rel', rel);
				}
			})();
		</script>
	</body>
</html>
