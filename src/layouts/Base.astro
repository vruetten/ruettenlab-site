---
import '../styles/site.css';
import '../styles/direction-a.css';
import '../styles/direction-b.css';
import { email, labName, linkedinUrl, nav, odbiUrl, pniUrl, postalAddress, princetonUrl, siteHref } from '../site';

interface Props {
	showEmail?: boolean;
	showAddress?: boolean;
	showLinkedin?: boolean;
	frontmatter?: { showEmail?: boolean; showAddress?: boolean; showLinkedin?: boolean; backdrop?: string };
}

const { showEmail = false, showAddress = false, showLinkedin = false, frontmatter } = Astro.props;
const emailUnderBody = showEmail || frontmatter?.showEmail === true;
const addressUnderBody = showAddress || frontmatter?.showAddress === true;
const linkedinUnderBody = showLinkedin || frontmatter?.showLinkedin === true;
const backdrop = frontmatter?.backdrop;
---

<html lang="en" data-direction="b" data-theme="dark">
	<head>
		<script is:inline>
			/* ruetten-direction */
			(function () {
				var root = document.documentElement;
				root.setAttribute('data-direction', 'b');
				root.setAttribute('data-theme', 'dark');
				function markOutsideLinks() {
					var origin = window.location.origin;
					var links = document.querySelectorAll('a[href]');
					for (var i = 0; i < links.length; i++) {
						var link = links[i];
						var href = link.getAttribute('href');
						if (!href || href.charAt(0) === '#') continue;
						var url;
						try {
							url = new URL(href, window.location.href);
						} catch (error) {
							continue;
						}
						var outside =
							url.origin !== origin && (url.protocol === 'http:' || url.protocol === 'https:');
						if (!outside) {
							if (link.getAttribute('target') === '_blank') link.removeAttribute('target');
							continue;
						}
						link.setAttribute('target', '_blank');
						var rel = link.getAttribute('rel') || '';
						if (rel.indexOf('noopener') === -1) rel = (rel + ' noopener').trim();
						if (rel.indexOf('noreferrer') === -1) rel = (rel + ' noreferrer').trim();
						link.setAttribute('rel', rel);
					}
				}
				if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', markOutsideLinks);
				else markOutsideLinks();
				function placeCrest() {
					var ul = document.querySelector('nav ul');
					if (!ul) return;
					var crest = ul.querySelector('li.institutes');
					var tabs = ul.querySelectorAll('li:not(.institutes)');
					if (!crest || tabs.length < 2) return;
					function sameRow(a, b) {
						var ar = a.getBoundingClientRect();
						var br = b.getBoundingClientRect();
						var mid = br.top + br.height / 2;
						return mid >= ar.top - 2 && mid <= ar.bottom + 2;
					}
					ul.classList.add('is-wrapped');
					var wrapped = !sameRow(tabs[0], crest);
					if (!wrapped) {
						for (var i = 1; i < tabs.length; i++) {
							if (!sameRow(tabs[0], tabs[i])) {
								wrapped = true;
								break;
							}
						}
					}
					if (wrapped) return;
					ul.classList.remove('is-wrapped');
					if (!sameRow(tabs[0], crest)) ul.classList.add('is-wrapped');
				}
				if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', placeCrest);
				else placeCrest();
				window.addEventListener('resize', placeCrest);
			})();
		</script>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={siteHref('favicon.svg')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<meta name="generator" content={Astro.generator} />
		<title>{labName}</title>
		<slot name="head" />
	</head>
	<body class:list={[{ 'has-backdrop': backdrop }]} style={backdrop ? `--backdrop: url('${siteHref(backdrop)}')` : undefined}>
		{backdrop && <div class="backdrop" aria-hidden="true" />}
		<header class="wrap">
			<nav>
					<ul>
						<li>
							<a href={siteHref()}>{labName}</a>
						</li>
						{
							nav.map((item) => (
								<li>
									<a href={siteHref(item.path)}>{item.label}</a>
								</li>
							))
						}
						<li class="institutes">
							<a class="princeton" href={princetonUrl}>
								<img class="lockup princeton-logo princeton-logo-color" src={siteHref('marks/princeton-wordmark.svg')} alt="Princeton University" width="263" height="72" />
								<img class="lockup princeton-logo princeton-logo-white" src={siteHref('marks/princeton-wordmark-white.svg')} alt="Princeton University" width="1852" height="500" />
								<img class="emblem princeton-logo princeton-logo-color" src={siteHref('marks/princeton-shield.svg')} alt="Princeton University" width="41" height="52" />
								<img class="emblem princeton-logo princeton-logo-white" src={siteHref('marks/princeton-shield-light.svg')} alt="Princeton University" width="41" height="52" />
							</a>
							<a class="pni" href={pniUrl}>
								<img class="lockup pni pni-color" src={siteHref('marks/pni.svg')} alt="Princeton Neuroscience Institute" width="341" height="85" />
								<img class="lockup pni pni-dark" src={siteHref('marks/pni-dark.svg')} alt="Princeton Neuroscience Institute" width="341" height="85" />
								<img class="emblem pni pni-color" src={siteHref('marks/pni-crest.svg')} alt="Princeton Neuroscience Institute" width="142" height="85" />
								<img class="emblem pni pni-dark" src={siteHref('marks/pni-crest-dark.svg')} alt="Princeton Neuroscience Institute" width="142" height="85" />
							</a>
							<a class="odbi" href={odbiUrl}>
								<img class="lockup odbi odbi-color" src={siteHref('marks/odbi.png')} alt="Omenn-Darling Bioengineering Institute" width="677" height="186" />
								<img class="lockup odbi odbi-dark" src={siteHref('marks/odbi-dark.png')} alt="Omenn-Darling Bioengineering Institute" width="677" height="186" />
								<img class="emblem odbi odbi-color" src={siteHref('marks/odbi-crest.png')} alt="Omenn-Darling Bioengineering Institute" width="258" height="186" />
								<img class="emblem odbi odbi-dark" src={siteHref('marks/odbi-crest-dark.png')} alt="Omenn-Darling Bioengineering Institute" width="258" height="186" />
							</a>
						</li>
					</ul>
			</nav>
		</header>
		<main class:list={['wrap', { 'with-postal': addressUnderBody }]}>
			<div class="page">
				<slot />
				{
					emailUnderBody && (
						<p class="contact">
							<a href={`mailto:${email}`}>{email}</a>
							{
								linkedinUnderBody && (
									<a class="linkedin" href={linkedinUrl} aria-label="LinkedIn">
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path
												fill="currentColor"
												d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z"
											/>
										</svg>
									</a>
								)
							}
						</p>
					)
				}
			</div>
			{
				addressUnderBody && (
					<address class="postal">
						<h2>Mailing address</h2>
						{postalAddress.map((line) => (
							<span>{line}</span>
						))}
					</address>
				)
			}
		</main>
		<footer class="contact-bar">
			<p class="copyright">© 2026 {labName}</p>
		</footer>
	</body>
</html>
